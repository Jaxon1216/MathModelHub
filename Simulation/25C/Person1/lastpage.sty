%% lastpage.sty - Simple replacement for lastpage package
\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{lastpage}[2023/01/01 Simple lastpage replacement]
\AtEndDocument{%
  \clearpage
  \addtocounter{page}{-1}%
  \immediate\write\@auxout{%
    \string\newlabel{LastPage}{{}{\thepage}{}{}{}}%
  }%
  \addtocounter{page}{1}%
}
\endinput
