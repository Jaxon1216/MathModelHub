%% environ.sty - More complete replacement
\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{environ}[2023/01/01 Simple environ replacement]
\RequirePackage{etoolbox}
\newcommand{\BODY}{}

\newcommand{\NewEnviron}[2][]{%
  \newenvironment{#2}{\def\BODY{}}{}%
}

\newcommand{\RenewEnviron}[2][]{%
  \let\BODY\relax
  \renewenvironment{#2}{\def\BODY{}}{}%
}

% expandonce is already defined in etoolbox, so we don't redefine it
\endinput
